#!/bin/sh
# Userspace AWG3 for Entware. Only interfaces recorded in managed.tsv are owned.
set -u
umask 077
PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
BASE=/opt/etc/awg3
CONF=$BASE/conf
PARSED=$CONF/parsed
STATE=$BASE/managed.tsv
RUN=/var/run/awg3
SOCKETS=/var/run/amneziawg
AWG=/opt/bin/awg
ENGINE=/opt/bin/amneziawg-go
SPLIT=/opt/bin/awg3-split-config
PYTHON=/opt/bin/python3
CONVERTER=/opt/lib/awg3/convert_profile.py
WATCHDOG=/opt/etc/init.d/S100awg3-watchdog
LOG=/opt/var/log/awg3.log
mkdir -p "$BASE" "$PARSED" "$RUN" /opt/var/log || exit 1
chmod 700 "$BASE" "$CONF" "$PARSED" "$RUN"
log() (
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 524288 ]; then mv -f "$LOG" "$LOG.1"; fi
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
    printf '%s\n' "$*"
)
valid_index() { case "$1" in [0-9]|[1-9][0-9]) return 0;; *) return 1;; esac; }
valid_source() (
    name=${1##*/}
    case "$name" in ''|.*|*[!A-Za-z0-9_.-]*|*.conf.conf) return 1;; *.conf) ;; *) return 1;; esac
    [ "$1" = "$CONF/$name" ]
)
validate_state() (
    [ -f "$STATE" ] || exit 0
    awk -F '\t' 'NF!=3 || seen[$1]++ || indexes[$2]++ {exit 1}' "$STATE" || exit 1
    while IFS="$(printf '\t')" read -r src idx ndms; do
        valid_source "$src" && valid_index "$idx" && [ "$ndms" = "OpkgTun$idx" ] || exit 1
    done < "$STATE"
)
ndms_exists() { ndmc -c "show interface $1" 2>/dev/null | grep -q '^[[:space:]]*type:'; }
ndms_owned_type() { ndmc -c "show interface $1" 2>/dev/null | grep -Eq '^[[:space:]]*type: OpkgTun[[:space:]]*$'; }
ndms_cmd() (
    result=$(ndmc -c "$1" 2>&1) || { log "NDMS command failed: $1"; exit 1; }
    if printf '%s\n' "$result" | grep -Eiq '(^|[[:space:]])(error|failed|invalid)([[]|:|[[:space:]])'; then
        log "NDMS rejected: $1"; exit 1
    fi
)
requirements() (
    [ "$(uname -m)" = aarch64 ] || { log "ERROR: aarch64 router required"; exit 1; }
    [ -c /dev/net/tun ] || { log "ERROR: /dev/net/tun missing"; exit 1; }
    for tool in "$AWG" "$ENGINE" "$SPLIT"; do
        [ -x "$tool" ] || { log "ERROR: missing executable $tool"; exit 1; }
    done
    for tool in ip ndmc awk mktemp; do command -v "$tool" >/dev/null || exit 1; done
    "$ENGINE" --version >/dev/null && "$AWG" --version >/dev/null
)
# Process identity prevents signalling a recycled PID or another VPN daemon.
engine_alive() (
    iface=$1
    [ -f "$RUN/$iface.pid" ] || exit 1
    pid=$(cat "$RUN/$iface.pid")
    case "$pid" in ''|*[!0-9]*) exit 1;; esac
    [ "$pid" -gt 1 ] || exit 1
    [ "$(readlink -f "/proc/$pid/exe" 2>/dev/null)" = "$(readlink -f "$ENGINE")" ] || exit 1
    tr '\000' '\n' < "/proc/$pid/cmdline" | grep -Fxq "$iface"
)
ensure_engine() (
    iface=$1
    if engine_alive "$iface"; then
        [ -S "$SOCKETS/$iface.sock" ] && "$AWG" show "$iface" >/dev/null 2>&1
        exit $?
    fi
    # Recover a socket left by a dead process only with our PID record.
    if [ -f "$RUN/$iface.pid" ] && ! ip link show "$iface" >/dev/null 2>&1; then
        old_pid=$(cat "$RUN/$iface.pid")
        case "$old_pid" in ''|*[!0-9]*) exit 1;; esac
        [ "$old_pid" -gt 1 ] || exit 1
        if ! kill -0 "$old_pid" 2>/dev/null; then rm -f "$SOCKETS/$iface.sock" "$RUN/$iface.pid"; fi
    fi
    if [ -S "$SOCKETS/$iface.sock" ]; then
        log "ERROR: unverified UAPI socket for $iface; refusing takeover"
        exit 1
    fi
    if ip link show "$iface" >/dev/null 2>&1; then
        # NDMS restores a persistent plain TUN at boot. TUNSETIFF refuses an occupied queue.
        idx=${iface#opkgtun}
        [ -f "/sys/class/net/$iface/tun_flags" ] &&
            awk -F '\t' -v i="$idx" '$2==i {found=1} END {exit !found}' "$STATE" &&
            ndms_owned_type "OpkgTun$idx" || {
                log "ERROR: $iface is not our NDMS TUN; refusing takeover"
                exit 1
            }
    fi
    # Foreground child has a known PID; detach its stdio from the SSH session.
    WG_PROCESS_FOREGROUND=1 LOG_LEVEL=error "$ENGINE" -f "$iface" </dev/null >> "$LOG" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$RUN/$iface.pid"
    n=0
    while [ "$n" -lt 15 ]; do
        if [ -S "$SOCKETS/$iface.sock" ] && "$AWG" show "$iface" >/dev/null 2>&1; then exit 0; fi
        kill -0 "$pid" 2>/dev/null || break
        n=$((n+1)); sleep 1
    done
    log "ERROR: engine did not become ready for $iface"
    if engine_alive "$iface"; then kill -TERM "$pid"; fi
    exit 1
)
parse_profile() (
    "$SPLIT" "$1" "opkgtun$2" "OpkgTun$2"
)
display_name() (
    name=$1
    label=$name
    if [ -f "$BASE/names/$name" ] && [ ! -L "$BASE/names/$name" ]; then
        candidate=$(cat "$BASE/names/$name")
        case "$candidate" in ''|*[!A-Za-z0-9_.\ -]*) ;; *) [ "${#candidate}" -le 64 ] && label=$candidate;; esac
    fi
    printf '%s\n' "$label"
)
rename_tunnel() (
    name=$1; label=$2
    valid_source "$CONF/$name.conf" && [ -f "$CONF/$name.conf" ] || exit 1
    case "$label" in ''|*[!A-Za-z0-9_.\ -]*) log 'Name: use Latin letters, digits, spaces, dot, dash or underscore'; exit 1;; esac
    [ "${#label}" -le 64 ] || exit 1
    idx=$(awk -F '\t' -v s="$CONF/$name.conf" '$1==s {print $2}' "$STATE")
    valid_index "$idx" && ndms_owned_type "OpkgTun$idx" || exit 1
    mkdir -p "$BASE/names" || exit 1
    chmod 700 "$BASE/names"
    tmp=$(mktemp "$BASE/names/.rename.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$label" > "$tmp" || exit 1
    old=$(display_name "$name")
    if ! ndms_cmd "interface OpkgTun$idx description \"$label\""; then
        ndms_cmd "interface OpkgTun$idx description \"$old\"" || log 'ERROR: name rollback failed'
        exit 1
    fi
    if ! mv -f "$tmp" "$BASE/names/$name"; then
        ndms_cmd "interface OpkgTun$idx description \"$old\"" || log 'ERROR: name rollback failed'
        exit 1
    fi
    log "Display name saved for OpkgTun$idx; profile filename unchanged"
)
configure() (
    src=$1; idx=$2; iface=opkgtun$idx; ndms=OpkgTun$idx
    # Parse before modifying any existing interface.
    parse_profile "$src" "$idx" || exit 1
    existing=0
    if ndms_exists "$ndms"; then
        existing=1
        ndms_owned_type "$ndms" || { log "ERROR: unexpected NDMS interface type"; exit 1; }
    else
        ndms_cmd "interface $ndms" || exit 1
    fi
    ensure_engine "$iface" || exit 1
    # Values never reach a shell; parser emits validated NDMS settings only.
    "$AWG" setconf "$iface" "$PARSED/$iface.awg.conf" >/dev/null 2>&1 || { log "ERROR: awg rejected $src"; exit 1; }
    name=${src##*/}; name=${name%.conf}
    label=$(display_name "$name")
    ndms_cmd "interface $ndms description \"$label\"" || exit 1
    if [ "$existing" -eq 1 ]; then
        sed '/^ndmc -c "interface .* ip global auto"/d' "$PARSED/$iface.ndms.sh" > "$PARSED/$iface.existing.sh" || exit 1
        settings=$PARSED/$iface.existing.sh
    else settings=$PARSED/$iface.ndms.sh; fi
    sh "$settings" || { log "ERROR: NDMS settings rejected for $ndms"; exit 1; }
    ip link set "$iface" up || exit 1
    log "$ndms configured; handshake must be checked with status"
)
reserve() (
    src=$1
    idx=$(awk -F '\t' -v s="$src" '$1==s {print $2}' "$STATE")
    if [ -n "$idx" ]; then printf '%s\n' "$idx"; exit 0; fi
    idx=0
    while [ "$idx" -le 99 ]; do
        if ! awk -F '\t' -v i="$idx" '$2==i {found=1} END {exit !found}' "$STATE" &&
           ! ip link show "opkgtun$idx" >/dev/null 2>&1 && ! ndms_exists "OpkgTun$idx"; then
            cp "$STATE" "$STATE.new" || exit 1
            printf '%s\t%s\tOpkgTun%s\n' "$src" "$idx" "$idx" >> "$STATE.new" || exit 1
            mv -f "$STATE.new" "$STATE" || exit 1
            printf '%s\n' "$idx"; exit 0
        fi
        idx=$((idx+1))
    done
    exit 1
)
# A paused profile stays paused across reboot and is ignored by the watchdog.
tunnel_down() (
    name=$1
    valid_source "$CONF/$name.conf" && [ -f "$CONF/$name.conf" ] || exit 1
    idx=$(awk -F '\t' -v s="$CONF/$name.conf" '$1==s {print $2}' "$STATE")
    valid_index "$idx" || exit 1
    mkdir -p "$BASE/paused" || exit 1
    if ndms_exists "OpkgTun$idx"; then
        ndms_owned_type "OpkgTun$idx" && ndms_cmd "interface OpkgTun$idx down" || exit 1
        : > "$BASE/paused/$name" || exit 1
    fi
    if engine_alive "opkgtun$idx"; then ip link set "opkgtun$idx" down || exit 1; fi
    : > "$BASE/paused/$name" || exit 1
    log "OpkgTun$idx paused"
)
tunnel_up() (
    name=$1
    valid_source "$CONF/$name.conf" && [ -f "$CONF/$name.conf" ] || exit 1
    requirements || exit 1
    [ -f "$STATE" ] || : > "$STATE"
    # Starting one after a whole-service stop must not revive its neighbours.
    if [ ! -f "$RUN/running" ]; then
        while IFS="$(printf '\t')" read -r other otheridx otherndms; do
            [ -f "$other" ] || continue
            : > "$RUN/stopped-$otheridx"
        done < "$STATE"
    fi
    idx=$(reserve "$CONF/$name.conf") || exit 1
    mkdir -p "$BASE/paused" || exit 1
    : > "$BASE/paused/$name" || exit 1
    if ! configure "$CONF/$name.conf" "$idx"; then
        tunnel_down "$name" || true
        log 'ERROR: tunnel could not start; profile retained and paused'
        exit 1
    fi
    rm -f "$BASE/paused/$name" "$RUN/stopped-$idx"
    : > "$RUN/running"
    [ ! -f "$BASE/watchdog-enabled" ] || "$WATCHDOG" start || exit 1
    log "OpkgTun$idx started; verify PingCheck"
)
terminate_engine() (
    iface=$1
    if engine_alive "$iface"; then
        pid=$(cat "$RUN/$iface.pid")
        kill -TERM "$pid" || exit 1
        n=0
        while engine_alive "$iface" && [ "$n" -lt 5 ]; do sleep 1; n=$((n+1)); done
        engine_alive "$iface" && { log 'ERROR: engine did not stop'; exit 1; }
    elif [ -S "$SOCKETS/$iface.sock" ]; then
        log 'ERROR: unverified engine socket; refusing deletion'; exit 1
    fi
    rm -f "$RUN/$iface.pid" "$SOCKETS/$iface.sock"
)
delete_tunnel() (
    name=$1
    valid_source "$CONF/$name.conf" && [ -f "$CONF/$name.conf" ] && [ ! -L "$CONF/$name.conf" ] || exit 1
    idx=$(awk -F '\t' -v s="$CONF/$name.conf" '$1==s {print $2}' "$STATE")
    # Back up credentials before changing the interface. Keep reserved indexes forever:
    # external policy/route references must never be inherited by a different VPN.
    mkdir -p "$BASE/backups/deleted" || exit 1
    backup=$(mktemp -d "$BASE/backups/deleted/$name.XXXXXX") || exit 1
    cp -p "$CONF/$name.conf" "$backup/profile.conf" || exit 1
    if [ -n "$idx" ]; then
        valid_index "$idx" || exit 1
        if ndms_exists "OpkgTun$idx"; then ndms_owned_type "OpkgTun$idx" || exit 1; fi
        tunnel_down "$name" || exit 1
        terminate_engine "opkgtun$idx" || exit 1
        if ndms_exists "OpkgTun$idx"; then
            ndms_cmd "no interface OpkgTun$idx" || exit 1
            if ndms_exists "OpkgTun$idx"; then log 'ERROR: firmware interface still exists; profile retained and paused'; exit 1; fi
        fi
    fi
    rm -f "$CONF/$name.conf" "$BASE/names/$name" "$BASE/paused/$name" || exit 1
    if [ -n "$idx" ]; then rm -f "$PARSED/opkgtun$idx.awg.conf" "$PARSED/opkgtun$idx.ndms.sh" "$PARSED/opkgtun$idx.existing.sh" "$PARSED/opkgtun$idx.import.sh"; fi
    log "Tunnel deleted; private backup: $backup. Save firmware configuration to retain interface removal."
)
start_service() (
    requirements || exit 1
    # Validate every profile first. A malformed file cannot disrupt a running VPN.
    found=0
    for src in "$CONF"/*.conf; do
        [ -f "$src" ] || continue
        valid_source "$src" || { log "ERROR: use simple ASCII profile filenames"; exit 1; }
        found=1
        name=${src##*/}; name=${name%.conf}
        [ ! -f "$BASE/paused/$name" ] || continue
        validation=$(mktemp -d "$RUN/validate.XXXXXX") || exit 1
        AWG3_PARSED_DIR="$validation" "$SPLIT" "$src" opkgtun99 OpkgTun99 >/dev/null
        result=$?
        rm -f "$validation/opkgtun99.awg.conf" "$validation/opkgtun99.ndms.sh"
        rmdir "$validation"
        [ "$result" -eq 0 ] || exit 1
        found=1
    done
    [ "$found" -eq 1 ] || { log "ERROR: no profiles in $CONF"; exit 1; }
    [ -f "$STATE" ] || : > "$STATE"
    failed=0
    : > "$RUN/running"
    for src in "$CONF"/*.conf; do
        [ -f "$src" ] || continue
        name=${src##*/}; name=${name%.conf}
        [ ! -f "$BASE/paused/$name" ] || continue
        idx=$(reserve "$src") || { failed=1; continue; }
        : > "$RUN/stopped-$idx"
        if configure "$src" "$idx"; then rm -f "$RUN/stopped-$idx"; else failed=1; fi
    done
    [ "$failed" -eq 0 ] || { log "Startup incomplete; check $LOG"; exit 1; }
    if [ -f "$BASE/watchdog-enabled" ]; then "$WATCHDOG" start || exit 1; fi
    log "Started. Autostart and saving firmware configuration are separate commands."
)
stop_service() (
    rm -f "$RUN/running"
    "$WATCHDOG" stop || exit 1
    [ -f "$STATE" ] || exit 0
    failed=0
    while IFS="$(printf '\t')" read -r src idx ndms; do
        [ -f "$src" ] || continue
        : > "$RUN/stopped-$idx"
        if engine_alive "opkgtun$idx"; then ip link set "opkgtun$idx" down || failed=1; fi
        if ndms_owned_type "$ndms"; then ndms_cmd "interface $ndms down" || failed=1; fi
    done < "$STATE"
    # Keep TUN processes and NDMS objects, retaining policy associations.
    exit "$failed"
)
status() (
    [ -f "$BASE/enabled" ] && echo 'Autostart: enabled' || echo 'Autostart: disabled'
    [ -f "$RUN/running" ] && echo 'Service: started' || echo 'Service: stopped'
    [ -s "$STATE" ] || { echo 'No managed tunnels'; exit 1; }
    failed=0
    while IFS="$(printf '\t')" read -r src idx ndms; do
        [ -f "$src" ] || continue
        echo "$ndms <- ${src##*/}"
        if engine_alive "opkgtun$idx"; then
            shown=$("$AWG" show "opkgtun$idx") || failed=1
            printf '%s\n' "$shown" | sed 's/\(header protection key: \).*/\1(hidden)/'
        else echo 'Engine: stopped'; failed=1; fi
        ndmc -c "show interface $ndms" 2>/dev/null | grep -E '^[[:space:]]*(state|link|connected|uptime):' || true
    done < "$STATE"
    exit "$failed"
)
repair() (
    idx=$1
    valid_index "$idx" || exit 1
    [ -f "$RUN/running" ] || { log 'Service intentionally stopped'; exit 1; }
    src=$(awk -F '\t' -v i="$idx" '$2==i {print $1}' "$STATE")
    [ -n "$src" ] && [ -f "$src" ] || exit 1
    name=${src##*/}; name=${name%.conf}
    [ ! -f "$BASE/paused/$name" ] && [ ! -f "$RUN/stopped-$idx" ] || exit 0
    configure "$src" "$idx"
)
# Import keeps the existing NDMS object, priority, policies, routes and DNS.
apply_import() (
    src=$1; idx=$2
    parse_profile "$src" "$idx" >/dev/null || exit 1
    ndms_owned_type "OpkgTun$idx" && engine_alive "opkgtun$idx" || exit 1
    "$AWG" setconf "opkgtun$idx" "$PARSED/opkgtun$idx.awg.conf" >/dev/null 2>&1 || exit 1
    # DNS is router policy, not changed by automatic credential rotation.
    sed '/^ndmc -c "ip name-server /d; /^ndmc -c "interface .* ip global auto"/d' \
        "$PARSED/opkgtun$idx.ndms.sh" > "$PARSED/opkgtun$idx.import.sh" || exit 1
    sh "$PARSED/opkgtun$idx.import.sh" || exit 1
    ip link set "opkgtun$idx" up
)
import_profile() (
    input=$1; name=$2; mode=${3:-replace}
    valid_source "$CONF/$name.conf" || { log 'ERROR: invalid import target'; exit 1; }
    [ -f "$input" ] && [ ! -L "$input" ] || { log 'ERROR: import requires a regular file'; exit 1; }
    [ -x "$PYTHON" ] && [ -f "$CONVERTER" ] || { log 'ERROR: install Python 3.10+ and importer first'; exit 1; }
    target=$CONF/$name.conf
    [ ! -L "$target" ] || exit 1
    idx=
    [ ! -f "$STATE" ] || idx=$(awk -F '\t' -v s="$target" '$1==s {print $2}' "$STATE")
    if [ "$mode" = create ]; then
        [ ! -e "$target" ] && [ -z "$idx" ] || { log 'ERROR: profile name already used or reserved; choose another'; exit 1; }
    fi
    live=0
    if [ "$mode" != create ] && [ -f "$RUN/running" ] && [ ! -f "$BASE/paused/$name" ] && [ ! -f "$RUN/stopped-$idx" ]; then
        live=1
        [ -n "$idx" ] && [ -f "$target" ] || { log 'ERROR: target is not an existing managed profile'; exit 1; }
        ndms_owned_type "OpkgTun$idx" && engine_alive "opkgtun$idx" || { log 'ERROR: target engine is unavailable'; exit 1; }
    fi
    stage=$(mktemp -d "$BASE/import.XXXXXX") || exit 1
    trap 'rm -f "$stage/profile.conf" "$stage/opkgtun99.awg.conf" "$stage/opkgtun99.ndms.sh"; rmdir "$stage"' EXIT
    # A private snapshot is bounded and parsed by the offline converter.
    "$PYTHON" "$CONVERTER" --input "$input" --output "$stage/profile.conf" --ipv4-only --router-import >/dev/null || { log "ERROR: export conversion rejected"; exit 1; }
    AWG3_PARSED_DIR="$stage" "$SPLIT" "$stage/profile.conf" opkgtun99 OpkgTun99 >/dev/null || exit 1
    # A client identity must not run on two tunnels at once.
    newkey=$(awk -F '=' '/^[[:space:]]*PrivateKey[[:space:]]*=/ {v=substr($0,index($0,"=")+1);gsub(/[[:space:]]/,"",v);print v;exit}' "$stage/profile.conf")
    for other in "$CONF"/*.conf; do
        [ -f "$other" ] && [ "$other" != "$target" ] || continue
        oldkey=$(awk -F '=' '/^[[:space:]]*PrivateKey[[:space:]]*=/ {v=substr($0,index($0,"=")+1);gsub(/[[:space:]]/,"",v);print v;exit}' "$other")
        [ "$newkey" != "$oldkey" ] || { log 'ERROR: this client key is already used by another tunnel'; exit 1; }
    done
    backup=
    if [ -f "$target" ]; then
        mkdir -p "$BASE/backups/imports" || exit 1
        backup=$(mktemp "$BASE/backups/imports/$name.XXXXXX") || exit 1
        cp -p "$target" "$backup" || exit 1
    fi
    mv -f "$stage/profile.conf" "$target" || exit 1
    if [ "$mode" = create ]; then
        tunnel_up "$name" || { log 'ERROR: profile created but startup failed; inspect its settings'; exit 1; }
        log 'Tunnel created. Configure its routes and PingCheck separately.'
    elif [ "$live" -eq 1 ]; then
        if ! apply_import "$target" "$idx"; then
            cp -p "$backup" "$stage/profile.conf" && mv -f "$stage/profile.conf" "$target" || {
                log 'ERROR: cannot restore profile file; inspect backups/imports'; exit 1;
            }
            if apply_import "$target" "$idx"; then log 'ERROR: import failed; previous configuration restored';
            else log 'ERROR: import and live rollback failed; previous file restored, manual recovery required'; fi
            exit 1
        fi
        log 'Profile replaced on existing interface; verify handshake and PingCheck. No firmware save performed.'
    else
        log 'Profile imported; service remains stopped. Use up to start.'
    fi
)
scan_inbox() (
    [ -d "$BASE/inbox" ] || exit 0
    for input in "$BASE/inbox/"*.vpn "$BASE/inbox/"*.txt; do
        [ -f "$input" ] && [ ! -L "$input" ] || continue
        filename=${input##*/}; name=${filename%.*}
        valid_source "$CONF/$name.conf" || continue
        # Inbox is for replacement only, including before startup.
        [ -f "$CONF/$name.conf" ] || continue
        archive=$(mktemp -d "$BASE/inbox/item.XXXXXX") || exit 1
        mv "$input" "$archive/source.${filename##*.}" || { rmdir "$archive"; continue; }
        source=$archive/source.${filename##*.}
        chmod 600 "$source"
        if import_profile "$source" "$name"; then
            printf '%s\n' "$filename applied; verify handshake" > "$archive/result"
        else
            printf '%s\n' "$filename rejected; inspect service log" > "$archive/result"
        fi
        # Keep the input privately for diagnosis; never retry a rejected file forever.
    done
)
# Never steal a lock: after SIGKILL diagnose the PID before removing it manually.
action=${1:-start}
case "$action" in status) validate_state && status; exit $?;; esac
mkdir "$RUN/service.lock" 2>/dev/null || { echo "Service busy ($RUN/service.lock)"; exit 1; }
echo "$$" > "$RUN/service.lock/pid"
trap 'rm -f "$RUN/service.lock/pid"; rmdir "$RUN/service.lock"' EXIT
trap 'exit 1' HUP INT TERM
validate_state || { log 'ERROR: invalid managed.tsv; refusing network changes'; exit 1; }
case "$action" in
    start) [ -f "$BASE/enabled" ] || { echo 'Autostart disabled; use up for a manual test'; exit 0; }; scan_inbox && start_service;;
    up) start_service;;
    stop) stop_service;;
    restart) stop_service && start_service;;
    create) import_profile "${2:-}" "${3:-}" create;;
    tunnel-up) tunnel_up "${2:-}";;
    tunnel-down) tunnel_down "${2:-}";;
    delete) delete_tunnel "${2:-}";;
    import) import_profile "${2:-}" "${3:-router}";;
    inbox) scan_inbox;;
    repair) repair "${2:-}";;
    enable) : > "$BASE/enabled"; echo 'Autostart enabled (does not start VPN)';;
    disable) rm -f "$BASE/enabled"; echo "Autostart disabled (VPN state unchanged)";;
    rename) [ "$#" -eq 3 ] || exit 1; rename_tunnel "$2" "$3";;
    save) ndms_cmd 'system configuration save';;
    *) echo "Usage: $0 {up|start|stop|restart|status|repair N|import FILE NAME|inbox|enable|disable|rename NAME LABEL|create FILE NAME|tunnel-up NAME|tunnel-down NAME|delete NAME|save}"; exit 1;;
esac
